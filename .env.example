# ==================== LLM配置 ====================
LLM_MODEL_ID=qwen-plus
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# ==================== 丰图科技API配置 ====================
FENGTU_API_KEY=your_fengtu_api_key_here
FENGTU_BASE_URL=https://api.fengtu.com
FENGTU_TIMEOUT=30
FENGTU_MAX_RETRIES=3

# ==================== 向量数据库配置（Milvus）====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_ADDRESS=fengtu_address_standard
MILVUS_COLLECTION_POI=fengtu_poi
MILVUS_DIMENSION=768

# ==================== Elasticsearch配置 ====================
ES_HOST=localhost
ES_PORT=9200
ES_USER=
ES_PASSWORD=
ES_INDEX_ADDRESS=address_inverted
ES_INDEX_POI=poi_inverted

# ==================== Embedding模型配置 ====================
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=768

# ==================== 数据库配置 ====================
SQLITE_DB_FILE=./data/agents.db
LANCEDB_URI=./data/lancedb

# ==================== RAG配置 ====================
RAG_TOP_K=10
RAG_SCORE_THRESHOLD=0.85
RAG_RERANK_ENABLED=true
RAG_RERANK_TOP_K=5

# ==================== 分级处理配置 ====================
RULE_PROCESS_RATIO=0.40
MODEL_PROCESS_RATIO=0.30
ES_PROCESS_RATIO=0.15
LLM_PROCESS_RATIO=0.15

# ==================== 幻觉抑制配置 ====================
HALLUCINATION_CHECK_ENABLED=true
CONFIDENCE_THRESHOLD=0.80
GEOMETRY_CHECK_ENABLED=true

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==================== 性能配置 ====================
BATCH_SIZE=100
MAX_WORKERS=10
CACHE_ENABLED=true
CACHE_TTL=3600
